<Project>
  <!--
    JSNet.Sdk can be used two ways:
      <Project Sdk="JSNet.Sdk/0.2.0">                       (imports Microsoft.NET.Sdk itself)
      <Project Sdk="Microsoft.NET.Sdk.Web">
        <Sdk Name="JSNet.Sdk" Version="0.2.0" />            (adds JS.Net on top of another SDK)
  -->
  <PropertyGroup>
    <UsingJSNetSdk>true</UsingJSNetSdk>
    <_JSNetImportsBaseSdk Condition="'$(UsingMicrosoftNETSdk)' != 'true'">true</_JSNetImportsBaseSdk>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="'$(_JSNetImportsBaseSdk)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)..\build\JSNet.Sdk.props" />
</Project>
