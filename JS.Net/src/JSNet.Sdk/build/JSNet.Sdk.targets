<Project>
  <!--
    JS.Net build integration.
    1. Collect **/*.jsn as JSNetCompile items.
    2. JSNetGenerate: run the jsnet compiler (incremental) → obj/<cfg>/<tfm>/jsnet/*.g.cs
    3. JSNetAddGenerated: add the generated C# to @(Compile); Roslyn produces IL, PDB (mapped to .jsn via #line),
       NativeAOT output, analyzers and IDE support.
    Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.
  -->
  <PropertyGroup>
    <JSNetGeneratedDir Condition="'$(JSNetGeneratedDir)' == ''">$(IntermediateOutputPath)jsnet\</JSNetGeneratedDir>
    <JSNetCompilerPath Condition="'$(JSNetCompilerPath)' == ''">$(MSBuildThisFileDirectory)..\tools\jsnet.dll</JSNetCompilerPath>
    <JSNetDotnetHost Condition="'$(JSNetDotnetHost)' == '' and '$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</JSNetDotnetHost>
    <JSNetDotnetHost Condition="'$(JSNetDotnetHost)' == ''">dotnet</JSNetDotnetHost>
    <JSNetIsLibrary Condition="'$(JSNetIsLibrary)' == '' and '$(OutputType)' == 'Library'">true</JSNetIsLibrary>
    <JSNetEmitLineDirectives Condition="'$(JSNetEmitLineDirectives)' == ''">true</JSNetEmitLineDirectives>
    <JSNetRootNamespace Condition="'$(JSNetRootNamespace)' == ''">$(RootNamespace)</JSNetRootNamespace>
    <JSNetRootNamespace Condition="'$(JSNetRootNamespace)' == ''">$(MSBuildProjectName.Replace('-', '_').Replace(' ', '_'))</JSNetRootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableDefaultJSNetItems)' == 'true'">
    <JSNetCompile Include="**\*.jsn" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);@(JSNetCompile)" />
    <None Remove="@(JSNetCompile)" />
  </ItemGroup>

  <!-- .NET MAUI single projects: Platforms/<platform>/*.jsn only compile for that platform's target framework. -->
  <ItemGroup Condition="'$(SingleProject)' == 'true'">
    <JSNetCompile Remove="Platforms\Android\**" Condition="'$(TargetPlatformIdentifier)' != 'android'" />
    <JSNetCompile Remove="Platforms\iOS\**" Condition="'$(TargetPlatformIdentifier)' != 'ios'" />
    <JSNetCompile Remove="Platforms\MacCatalyst\**" Condition="'$(TargetPlatformIdentifier)' != 'maccatalyst'" />
    <JSNetCompile Remove="Platforms\Windows\**" Condition="'$(TargetPlatformIdentifier)' != 'windows'" />
    <JSNetCompile Remove="Platforms\Tizen\**" Condition="'$(TargetPlatformIdentifier)' != 'tizen'" />
  </ItemGroup>

  <!-- Implicit runtime references (package flavour). In-repo builds use project references instead. -->
  <ItemGroup Condition="'$(JSNetUseProjectReferences)' != 'true'">
    <PackageReference Include="JSNet.Runtime" Version="$(JSNetSdkVersion)" IsImplicitlyDefined="true" Condition="'$(JSNetDisableImplicitRuntimeReference)' != 'true'" />
    <PackageReference Include="JSNet.AI" Version="$(JSNetSdkVersion)" IsImplicitlyDefined="true" Condition="'$(JSNetEnableAI)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Any change to the compiler (e.g. an SDK update) invalidates the generated code. -->
    <_JSNetCompilerFiles Include="$([System.IO.Path]::GetDirectoryName('$(JSNetCompilerPath)'))\JSNet*.dll;$(JSNetCompilerPath)" />
  </ItemGroup>

  <!-- Ships next to jsnet.dll and hands the work to the JS.Net build server (JSNetUseBuildServer=false or JSNET_NO_BUILD_SERVER=1 opts out). -->
  <PropertyGroup>
    <JSNetTasksAssembly Condition="'$(JSNetTasksAssembly)' == ''">$([System.IO.Path]::GetDirectoryName('$(JSNetCompilerPath)'))\JSNet.Sdk.Tasks.dll</JSNetTasksAssembly>
    <JSNetUseBuildServer Condition="'$(JSNetUseBuildServer)' == ''">true</JSNetUseBuildServer>
  </PropertyGroup>
  <UsingTask TaskName="JSNet.Sdk.Tasks.JsNetCompile" AssemblyFile="$(JSNetTasksAssembly)" Condition="'$(JSNetTasksOutOfProc)' != 'true'" />
  <UsingTask TaskName="JSNet.Sdk.Tasks.JsNetCompile" AssemblyFile="$(JSNetTasksAssembly)" TaskFactory="TaskHostFactory" Condition="'$(JSNetTasksOutOfProc)' == 'true'" />

  <Target Name="JSNetGenerate"
          BeforeTargets="BeforeCompile;CoreCompile;XamlPreCompile"
          Condition="'@(JSNetCompile)' != ''"
          Inputs="@(JSNetCompile);$(MSBuildProjectFullPath);@(_JSNetCompilerFiles);@(JSNetAnalyzer)"
          Outputs="$(JSNetGeneratedDir)jsnet.stamp">
    <PropertyGroup>
      <_JSNetResponseFile>$(JSNetGeneratedDir)jsnet.rsp</_JSNetResponseFile>
    </PropertyGroup>
    <MakeDir Directories="$(JSNetGeneratedDir)" />
    <WriteLinesToFile File="$(_JSNetResponseFile)" Lines="@(JSNetCompile->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Error Condition="!Exists('$(JSNetCompilerPath)')" Text="JS.Net compiler not found at '$(JSNetCompilerPath)'." Code="JSN3004" />
    <JsNetCompile CompilerPath="$(JSNetCompilerPath)" DotnetHost="$(JSNetDotnetHost)" ResponseFile="$(_JSNetResponseFile)"
                  OutputDirectory="$(JSNetGeneratedDir.TrimEnd('\'))" RootNamespace="$(JSNetRootNamespace)" ProjectDirectory="$(MSBuildProjectDirectory)"
                  IsLibrary="$(JSNetIsLibrary)" EmitLineDirectives="$(JSNetEmitLineDirectives)" NoWarn="$(JSNetNoWarn)"
                  Analyzers="@(JSNetAnalyzer)" UseBuildServer="$(JSNetUseBuildServer)" />
    <Touch Files="$(JSNetGeneratedDir)jsnet.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="JSNetAddGenerated" AfterTargets="JSNetGenerate" BeforeTargets="BeforeCompile;CoreCompile;XamlPreCompile" Condition="'@(JSNetCompile)' != ''">
    <ItemGroup>
      <_JSNetGenerated Include="$(JSNetGeneratedDir)*.g.cs" />
      <Compile Remove="@(_JSNetGenerated)" />
      <Compile Include="@(_JSNetGenerated)" />
      <FileWrites Include="@(_JSNetGenerated);$(JSNetGeneratedDir)jsnet.stamp;$(JSNetGeneratedDir)jsnet.rsp" />
    </ItemGroup>
  </Target>

  <Target Name="JSNetClean" AfterTargets="Clean">
    <RemoveDir Directories="$(JSNetGeneratedDir)" />
  </Target>
</Project>
