<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>JS.Net AI-native features: `ai function` and `prompt` declarations backed by Microsoft.Extensions.AI (IChatClient) — works with OpenAI, Azure OpenAI, Ollama and Semantic Kernel. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>JSNet.AI</PackageId>
    <NoWarn>$(NoWarn);CS8981;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JSNet.Runtime\JSNet.Runtime.csproj" />
  </ItemGroup>
</Project>
