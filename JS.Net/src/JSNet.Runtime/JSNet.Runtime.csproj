<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>JS.Net runtime support: console, JSON, Math, Promise, Date, fetch, timers, JavaScript-style collection and string APIs (as C# 14 extension members) and @Service dependency injection. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>JSNet.Runtime</PackageId>
    <NoWarn>$(NoWarn);CS8981;CS1591</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
</Project>
