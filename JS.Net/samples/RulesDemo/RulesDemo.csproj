<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build the rules first, then run them on this project's .jsn files. -->
    <ProjectReference Include="..\JsNetRules\JsNetRules.csproj" ReferenceOutputAssembly="false" />
    <JSNetAnalyzer Include="..\JsNetRules\bin\$(Configuration)\net10.0\JsNetRules.dll" />
  </ItemGroup>
</Project>
