@inherits LayoutComponentBase

<div class="app">
    <aside class="rail" aria-label="Gallery navigation">
        <a class="brand" href="/">
            <img src="icon.png" alt="" width="36" height="36" />
            <span><strong>JS.Net</strong> Gallery</span>
        </a>

        <nav>
            <NavLink class="rail-link" href="/" Match="NavLinkMatch.All">Overview</NavLink>
            @foreach (var category in Catalog.categories)
            {
                <p class="rail-group">@category</p>
                @foreach (var s in Catalog.samples.Where(x => x.category == category))
                {
                    <NavLink class="rail-link" href="@($"samples/{s.id}")">@s.title</NavLink>
                }
            }
            <p class="rail-group">Build with it</p>
            <NavLink class="rail-link" href="components">UI components</NavLink>
            <NavLink class="rail-link" href="playground">Playground</NavLink>
        </nav>

        <p class="credit">@Catalog.credit</p>
    </aside>

    <main class="stage">
        @Body
    </main>
</div>
