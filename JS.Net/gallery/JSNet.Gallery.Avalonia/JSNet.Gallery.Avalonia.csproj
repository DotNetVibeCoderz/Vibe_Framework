<Project Sdk="Microsoft.NET.Sdk">
  <!-- JS.Net Gallery for Avalonia UI (Windows, macOS, Linux): AXAML views with code-behind written in JS.Net. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JSNet.Gallery.Avalonia</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <JSNetNoWarn>JSN2001;JSN2002</JSNetNoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <ProjectReference Include="..\JSNet.Gallery.Samples\JSNet.Gallery.Samples.csproj" />
    <AvaloniaResource Include="icon.png" />
  </ItemGroup>
</Project>
