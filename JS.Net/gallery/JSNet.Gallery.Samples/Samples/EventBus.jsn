// Use case: a typed event bus and a traffic-light state machine.

export class EventBus<T> {
    private handlers = new Map<string, Array<(payload: T) => void>>();

    on(topic: string, handler: (payload: T) => void): void {
        if (!this.handlers.has(topic)) this.handlers.set(topic, new Array<(payload: T) => void>());
        this.handlers.get(topic).push(handler);
    }

    emit(topic: string, payload: T): int {
        const list = this.handlers.get(topic);
        if (list == null) return 0;
        list.forEach(h => h(payload));
        return list.length;
    }
}

enum Light { Red, Green, Yellow }

function nextLight(l: Light): Light {
    switch (l) {
        case Light.Red: return Light.Green;
        case Light.Green: return Light.Yellow;
        default: return Light.Red;
    }
}

export async function eventBusDemo(): Promise<void> {
    const bus = new EventBus<string>();
    bus.on("deploy", v => console.log(`  [slack] deployed ${v}`));
    bus.on("deploy", v => console.log(`  [audit] version ${v} recorded`));
    console.log("handlers notified:", bus.emit("deploy", "v0.1.0"));

    let light = Light.Red;
    const cycle = new Array<string>();
    for (let i = 0; i < 6; i++) {
        cycle.push(light.ToString());
        light = nextLight(light);
    }
    console.log("traffic light:", cycle.join(" → "));
}
