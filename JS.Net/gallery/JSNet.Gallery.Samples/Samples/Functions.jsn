// Functions, arrow functions, default and rest parameters, closures and higher-order functions.

function greet(name: string, greeting = "Hello"): string {
    return `${greeting}, ${name}!`;
}

function total(...values: number[]): number {
    return values.reduce((sum, v) => sum + v, 0);
}

function makeCounter(): () => int {
    let count = 0;
    return () => ++count;
}

const compose = (f: (x: number) => number, g: (x: number) => number) => (x: number) => g(f(x));

export async function functionsDemo(): Promise<void> {
    console.log(greet("Ada"));
    console.log(greet("Linus", "Hi"));
    console.log("total(1, 2, 3, 4) =", total(1, 2, 3, 4));

    const next = makeCounter();
    next(); next();
    console.log("counter after three calls:", next());

    const double = (x: number) => x * 2;
    const increment = (x: number) => x + 1;
    const doubleThenIncrement = compose(double, increment);
    console.log("compose(double, increment)(10) =", doubleThenIncrement(10));

    const squares = [1, 2, 3, 4, 5].map(n => n * n);
    console.log("squares:", squares);
}
