<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shared JS.Net Gallery content, written in JS.Net: samples, component view-models and the code highlighter. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JSNet.Gallery</RootNamespace>
    <JSNetEnableAI>true</JSNetEnableAI>
    <JSNetNoWarn>JSN2001;JSN2002;JSN2003</JSNetNoWarn>
    <NoWarn>$(NoWarn);NU1603;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Samples\*.jsn" LogicalName="samples/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Samples\Ecosystem\*.jsn" LogicalName="samples/Ecosystem.%(Filename)%(Extension)" />
    <ProjectReference Include="$(JSNetRepoRoot)src\JSNet.Compiler\JSNet.Compiler.csproj" />
    <!-- Gravicode ecosystem libraries used by the "Ecosystem" samples. -->
    <PackageReference Include="Gravicode.RLNet" Version="0.3.0" />
    <PackageReference Include="Gravicode.Matplotlib.Net" Version="1.2.0" />
    <PackageReference Include="Gravicode.Science.GraviLearn" Version="1.4.0" />
    <PackageReference Include="Gravicode.HFNet.GraviTokenizers" Version="0.11.1" />
    <!-- Text tasks only (the umbrella package also brings the vision stack and ImageSharp 3.1.12 with known advisories); native ONNX Runtime as the umbrella does. -->
    <PackageReference Include="Gravicode.MediaPipeNet.Tasks.Text" Version="1.0.0" />
    <PackageReference Include="Gravicode.MediaPipeNet.Models.Text" Version="1.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="IoTCom.Net" Version="0.22.0-preview.1" />
    <PackageReference Include="ThreeNet" Version="0.12.0" />
  </ItemGroup>
</Project>
