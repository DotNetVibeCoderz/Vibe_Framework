<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>JSNet.Templates</PackageId>
    <PackageType>Template</PackageType>
    <IsPackable>true</IsPackable>
    <Description>dotnet new templates for JS.Net: console (jsnet), classlib, webapi, web, blazor, wpf, winforms, avalonia, worker and xunit. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.</Description>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
  </ItemGroup>
</Project>
