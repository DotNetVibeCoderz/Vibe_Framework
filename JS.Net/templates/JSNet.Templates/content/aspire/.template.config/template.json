{
  "$schema": "http://json.schemastore.org/template",
  "author": "Gravicode Studios (Kang Fadhil)",
  "classifications": [
    "JS.Net",
    "Cloud",
    "Aspire",
    "Web"
  ],
  "identity": "JSNet.Templates.aspire",
  "groupIdentity": "JSNet.aspire",
  "name": "JS.Net Aspire App",
  "description": "A .NET Aspire app host orchestrating a JS.Net Web API, both written in JS.Net. Dibuat oleh Gravicode Studios dipimpin oleh Kang Fadhil.",
  "shortName": [
    "jsnet-aspire"
  ],
  "sourceName": "JsNetApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "JS.Net",
    "type": "solution"
  },
  "symbols": {
    "sdkVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.2.1",
      "replaces": "JSNET_SDK_VERSION",
      "description": "JSNet.Sdk / JSNet.Runtime version."
    },
    "safeName": {
      "type": "generated",
      "generator": "regex",
      "replaces": "JsNetAppSafe",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "[^A-Za-z0-9_]",
            "replacement": "_"
          }
        ]
      }
    }
  }
}