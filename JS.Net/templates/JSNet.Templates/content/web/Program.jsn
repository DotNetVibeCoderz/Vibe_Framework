import Microsoft.AspNetCore.Builder;

const app = WebApplication.CreateBuilder(args).Build();

app.UseDefaultFiles();
app.UseStaticFiles();
app.MapGet("/api/time", () => ({ now: new Date().toISOString(), poweredBy: "JS.Net" }));

app.Run();
