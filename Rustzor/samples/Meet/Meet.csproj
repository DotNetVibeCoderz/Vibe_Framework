<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- A Rustzor sample app: video calls between browser tabs over WebRTC. Built by Gravicode Studios, led by Kang Fadhil. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Meet</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Rustzor.UI\Rustzor.UI.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.WebRTC\Rustzor.Browser.WebRTC.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.Media\Rustzor.Browser.Media.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.WebSocket\Rustzor.Browser.WebSocket.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.Storage\Rustzor.Browser.Storage.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.DOM\Rustzor.Browser.DOM.csproj" />
  </ItemGroup>
</Project>
