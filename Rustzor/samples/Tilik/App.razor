<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ReviewLayout)" />
    </Found>
    <NotFound>
        <div class="tk-lost">
            <h1>No such sheet</h1>
            <p>This review has two pages: the model and its bill of materials.</p>
            <a class="tk-btn primary" href="">Open the model</a>
        </div>
    </NotFound>
</Router>
<Toaster />
