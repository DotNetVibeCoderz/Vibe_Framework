@inherits LayoutComponentBase
@implements IDisposable
@* The review's title block: what is under review, which revision, who makes it. *@

<div class="tk-app">
    <header class="tk-head">
        <a class="tk-brand" href="" aria-label="Tilik, the model">
            <svg class="tk-mark" viewBox="0 0 32 32" aria-hidden="true">
                <rect x="1" y="1" width="30" height="30" rx="6" class="tk-mark-bg" />
                <circle cx="16" cy="16" r="7.5" class="tk-mark-ring" />
                <path d="M16 3.5v6M16 22.5v6M3.5 16h6M22.5 16h6" class="tk-mark-cross" />
            </svg>
            <span class="tk-brand-text"><b>Tilik</b><small>design review</small></span>
        </a>
        <div class="tk-doc" aria-label="Under review">
            <span class="tk-doc-name">@(Review.Product == "" ? "Loading the model…" : Review.Product)</span>
            @if (Review.Revision != "")
            {
                <span class="tk-rev" title="Revision">Rev @Review.Revision</span>
            }
            @if (Review.Maker != "")
            {
                <span class="tk-doc-maker">@Review.Maker</span>
            }
        </div>
        <nav class="tk-nav" aria-label="Pages">
            <NavLink href="" Match="NavLinkMatch.All"><Glyph Name="cube" Size="16" /> <span>Model</span></NavLink>
            <NavLink href="bom"><Glyph Name="list" Size="16" /> <span>Bill of materials</span></NavLink>
        </nav>
        <ThemeToggle />
    </header>
    <main class="tk-main">@Body</main>
</div>

@code {
    protected override void OnInitialized() => Review.Changed += Redraw;
    private void Redraw() => StateHasChanged();
    public void Dispose() => Review.Changed -= Redraw;
}
