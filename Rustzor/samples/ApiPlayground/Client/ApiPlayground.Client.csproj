<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- The API Playground's Rustzor client: REST, WebSocket, SignalR and gRPC-Web from C# in the browser. Built by Gravicode Studios, led by Kang Fadhil. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiPlayground</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Rustzor.UI\Rustzor.UI.csproj" />
    <ProjectReference Include="..\..\..\src\Browser\Rustzor.Browser.Fetch\Rustzor.Browser.Fetch.csproj" />
    <ProjectReference Include="..\..\..\src\Browser\Rustzor.Browser.WebSocket\Rustzor.Browser.WebSocket.csproj" />
    <ProjectReference Include="..\..\..\src\Browser\Rustzor.Browser.Storage\Rustzor.Browser.Storage.csproj" />
    <ProjectReference Include="..\..\..\src\Net\Rustzor.Net.SignalR\Rustzor.Net.SignalR.csproj" />
    <ProjectReference Include="..\..\..\src\Net\Rustzor.Net.GrpcWeb\Rustzor.Net.GrpcWeb.csproj" />
  </ItemGroup>
</Project>
