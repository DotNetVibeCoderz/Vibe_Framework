@page "/"
@implements IDisposable

<PageHeader Title="Good day, team" Eyebrow="@DateTime.Today.ToString("dddd, d MMMM yyyy")" Text="Where the pipeline stands, what is likely to close, and who needs a call today.">
    <Actions>
        <a class="rz-btn primary" href="deals"><Icon Name="wallet" /> Open the board</a>
    </Actions>
</PageHeader>

@if (deals is null)
{
    <p class="muted">Opening the database…</p>
}
else
{
    var open = deals.Where(d => d.Stage is not ("won" or "lost")).ToList();
    var quarterStart = new DateTime(DateTime.Today.Year, (DateTime.Today.Month - 1) / 3 * 3 + 1, 1).ToString("yyyy-MM-dd");
    var wonQuarter = deals.Where(d => d.Stage == "won" && string.CompareOrdinal(d.CloseDate, quarterStart) >= 0).ToList();
    var closed = deals.Count(d => d.Stage is "won" or "lost");
    <div class="rz-grid rz-grid-4">
        <StatCard Label="Open pipeline" Value="@Catalog.Money(open.Sum(d => d.Value))" Hint="@($"{open.Count} deals in play")" />
        <StatCard Label="Weighted forecast" Value="@Catalog.Money(open.Sum(d => d.Value * (decimal)Catalog.StageOf(d.Stage).Probability))" Hint="value × stage probability" />
        <StatCard Label="Won this quarter" Value="@Catalog.Money(wonQuarter.Sum(d => d.Value))" Hint="@($"{wonQuarter.Count} deals since {quarterStart}")" Trend="trend" />
        <StatCard Label="Win rate" Value="@(closed == 0 ? "—" : (deals.Count(d => d.Stage == "won") * 100 / closed) + "%")" Hint="won ÷ closed, all time" />
    </div>

    <div class="two section">
        <div class="rz-stack">
            <Card Title="Pipeline by stage" Subtitle="Value of open deals at each step">
                <div class="funnel">
                    @{ var top = Math.Max(1m, Catalog.Stages.Take(4).Max(s => open.Where(d => d.Stage == s.Id).Sum(d => d.Value))); }
                    @foreach (var s in Catalog.Stages.Take(4))
                    {
                        var value = open.Where(d => d.Stage == s.Id).Sum(d => d.Value);
                        var count = open.Count(d => d.Stage == s.Id);
                        <div class="funnel-row tone-@s.Tone">
                            <span>@s.Name</span>
                            <div><div class="funnel-bar" style="width:@((value / top * 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%">@count</div></div>
                            <span class="mono">@Catalog.Money(value)</span>
                        </div>
                    }
                </div>
            </Card>
            <Card Title="Expected closes" Subtitle="Open deal value by close month, weighted by stage">
                <BarChart Labels="months" Series="forecast" Height="220" AriaLabel="Weighted forecast by month" />
            </Card>
        </div>
        <div class="rz-stack">
            <Card Title="Needs attention" Subtitle="Overdue and due today">
                @{ var urgent = activities!.Where(a => a.Done == 0 && string.CompareOrdinal(a.Due, Today) <= 0).Take(6).ToList(); }
                @if (urgent.Count == 0)
                {
                    <EmptyState Icon="check" Title="All caught up" Text="Nothing is overdue. Plan the week on the activities page." />
                }
                else
                {
                    <ul class="timeline">
                        @foreach (var a in urgent)
                        {
                            var item = a;
                            <li class="@(string.CompareOrdinal(item.Due, Today) < 0 ? "late" : "")">
                                <span class="ico"><Icon Name="@Catalog.KindIcon(item.Kind)" Size="15" /></span>
                                <div><div class="what">@item.Subject</div><div class="meta">@item.Company · @item.Owner</div></div>
                                <button class="rz-btn small" @onclick="() => Complete(item)">Done</button>
                            </li>
                        }
                    </ul>
                }
            </Card>
            <Card Title="Top accounts" Subtitle="By open pipeline">
                <ul class="timeline">
                    @foreach (var c in open.GroupBy(d => d.Company).Select(g => (Name: g.Key, Value: g.Sum(d => d.Value), Count: g.Count())).OrderByDescending(x => x.Value).Take(5))
                    {
                        <li>
                            <Avatar Name="@c.Name" Size="30" />
                            <div><div class="what">@c.Name</div><div class="meta">@c.Count open deals</div></div>
                            <span class="mono">@Catalog.Money(c.Value)</span>
                        </li>
                    }
                </ul>
            </Card>
        </div>
    </div>
}

@code {
    private List<Deal>? deals;
    private List<Activity>? activities;
    private List<string> months = new();
    private List<ChartSeries> forecast = new();
    private List<double> trend = new();
    private static string Today => DateTime.Today.ToString("yyyy-MM-dd");

    protected override async Task OnInitializedAsync()
    {
        CrmDb.Changed += OnChanged;
        await Load();
    }

    private async Task Load()
    {
        deals = await CrmDb.DealsAsync();
        activities = await CrmDb.ActivitiesAsync();
        var open = deals.Where(d => d.Stage is not ("won" or "lost")).ToList();
        var start = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        var span = Enumerable.Range(0, 6).Select(i => start.AddMonths(i)).ToList();
        months = span.Select(m => m.ToString("MMM")).ToList();
        forecast = new()
        {
            new("Weighted (Rp jt)", span.Select(m => (double)open.Where(d => d.CloseDate.StartsWith(m.ToString("yyyy-MM")))
                .Sum(d => d.Value * (decimal)Catalog.StageOf(d.Stage).Probability) / 1_000_000d).ToList()),
        };
        // Won value per month for the last eight months: the sparkline on the won card.
        trend = Enumerable.Range(0, 8).Select(i => start.AddMonths(i - 7))
            .Select(m => (double)deals.Where(d => d.Stage == "won" && d.CloseDate.StartsWith(m.ToString("yyyy-MM"))).Sum(d => d.Value)).ToList();
    }

    private async Task Complete(Activity a)
    {
        await CrmDb.CompleteActivityAsync(a.Id, true);
        Toasts.Success($"Done: {a.Subject}");
    }

    private async void OnChanged()
    {
        await Load();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => CrmDb.Changed -= OnChanged;
}
