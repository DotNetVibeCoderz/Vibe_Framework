        "search" => "<circle cx='8' cy='8' r='5'/><path d='M11.8 11.8 15.5 15.5'/>",
        "style" => "<circle cx='9' cy='9' r='6.5'/><circle cx='6.3' cy='7' r='1.1' fill='currentColor'/><circle cx='9.5' cy='5.4' r='1.1' fill='currentColor'/><circle cx='12' cy='8.2' r='1.1' fill='currentColor'/><path d='M9 15.5c-1.6 0-2-1.5-1-2.4 1.1-1 2.8-.2 4-1'/>",
        "target" => "<circle cx='9' cy='9' r='6'/><circle cx='9' cy='9' r='2.5'/>",
        "chevron" => "<path d='M6.5 4 11.5 9l-5 5'/>",
        "reset" => "<path d='M3.5 9a5.5 5.5 0 1 0 1.6-3.9'/><path d='M3 2.8v3.4h3.4'/>",
        "wave" => "<path d='M1.5 7c1.5-1.4 3-1.4 4.5 0s3 1.4 4.5 0 3-1.4 4.5 0M1.5 11.5c1.5-1.4 3-1.4 4.5 0s3 1.4 4.5 0 3-1.4 4.5 0'/>",
        "check" => "<path d='M3.5 9.5 7.2 13 14.5 5'/>",
        _ => "<circle cx='9' cy='9' r='3' fill='currentColor'/>",
