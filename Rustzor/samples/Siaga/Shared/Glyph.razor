        "plus" => "<path d='M9 3.5v11M3.5 9h11'/>",
        "minus" => "<path d='M3.5 9h11'/>",
        "eye" => "<path d='M1.8 9S4.5 4 9 4s7.2 5 7.2 5-2.7 5-7.2 5S1.8 9 1.8 9z'/><circle cx='9' cy='9' r='2'/>",
