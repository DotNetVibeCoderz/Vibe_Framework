@* Siaga's icons: an 18-unit grid, 1.6 strokes with round ends, drawn like the symbols of a map legend. *@
<svg class="gl @Class" width="@Size" height="@Size" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@((MarkupString)Path(Name))</svg>

@code {
    [Parameter] public string Name { get; set; } = "dot";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string? Class { get; set; }

    public static string Path(string name) => name switch
    {
        "identify" => "<path d='M4 2.5 13.5 9l-4.2 1 2.4 4.6-1.8.9-2.4-4.6L4.5 14z'/>",
        "point" => "<path d='M9 16s5-4.6 5-8.6a5 5 0 0 0-10 0c0 4 5 8.6 5 8.6z'/><circle cx='9' cy='7.4' r='1.8'/>",
