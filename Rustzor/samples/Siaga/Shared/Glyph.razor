        "area" => "<path d='M3 3h12v12H3z' stroke-dasharray='2.2 2'/><path d='M6 12 12 6M6 9l3-3M9 12l3-3'/>",
        "lasso" => "<path d='M5.2 12.4C2.8 11.3 2.4 8.8 3.4 6.8c1.4-2.8 6-3.9 9.2-2.4 2.8 1.4 2.6 4.6-.3 6-1.9.9-4.4 1-6.5.7' stroke-dasharray='2.4 1.8'/><path d='M5.8 12.5c.6 1 .3 2.1-.6 2.9'/>",
        "buffer" => "<circle cx='9' cy='9' r='2'/><circle cx='9' cy='9' r='6.5' stroke-dasharray='2.2 2'/>",
        "edit" => "<path d='M3 13.5 7.5 4l7 3.5-3 7z'/><rect x='5.9' y='2.4' width='3.2' height='3.2' fill='currentColor'/><rect x='1.4' y='11.9' width='3.2' height='3.2' fill='var(--panel)'/>",
