<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- A Rustzor sample app: a digital twin of a water treatment plant. Built by Gravicode Studios, led by Kang Fadhil. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bening</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The twin engine: the seeded plant simulator, alarm evaluation, glTF + WebGL2 view, timeline and sparklines. -->
    <EmbeddedResource Include="rustzor.module.js" LogicalName="rustzor.module.js" />
    <None Remove="assets-src\**" />
    <ProjectReference Include="..\..\src\Rustzor.UI\Rustzor.UI.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.Storage\Rustzor.Browser.Storage.csproj" />
  </ItemGroup>
</Project>
