@page "/laporan"
@implements IDisposable
@* The daily log sheet a PDAM plant keeps by hand: one row per hour of readings, the day's
   totals, the alarms and what each shift did. Everything can leave as CSV. *@

<div class="bn-report">
    <header class="bn-report-head">
        <div>
            <span class="bn-eyebrow">@L.T("Lembar log harian", "Daily log sheet")</span>
            <h1>@Plant.Name</h1>
            <p class="bn-muted">@Twin.Day(Twin.Now) · @L.T("s.d. pukul", "up to") <span class="bn-mono">@Twin.Clock(Twin.Now)</span> · @L.T("operator shift pagi", "morning shift operator") @Plant.Operator</p>
        </div>
        <div class="bn-btnrow">
            <button class="bn-btn primary" data-export="history" @onclick="Twin.ExportHistory"><Glyph Name="download" Size="15" /> @L.T("Riwayat per menit (CSV)", "History by minute (CSV)")</button>
            <button class="bn-btn" data-export="hourly" @onclick="ExportHourly"><Glyph Name="download" Size="15" /> @L.T("Log per jam (CSV)", "Hourly log (CSV)")</button>
            <button class="bn-btn" data-export="alarms" @onclick="Twin.ExportAlarms"><Glyph Name="download" Size="15" /> @L.T("Alarm (CSV)", "Alarms (CSV)")</button>
            <button class="bn-btn" data-export="orders" @onclick="Twin.ExportOrders"><Glyph Name="download" Size="15" /> @L.T("Perintah kerja (CSV)", "Work orders (CSV)")</button>
        </div>
    </header>

    <section class="bn-totals" aria-label="@L.T("Ringkasan hari ini", "Today in totals")">
        <div><span>@L.T("Air diproduksi", "Water produced")</span><b class="bn-mono">@Twin.Fmt(Twin.Kpi[0], 0) m³</b></div>
        <div><span>@L.T("Energi listrik", "Electricity")</span><b class="bn-mono">@Twin.Fmt(Twin.Kpi[1], 0) kWh</b></div>
        <div><span>@L.T("Energi spesifik", "Specific energy")</span><b class="bn-mono">@Twin.Fmt(Twin.Kpi[2], 3) kWh/m³</b></div>
        <div><span>@L.T("PAC terpakai", "PAC used")</span><b class="bn-mono">@Twin.Fmt(Twin.Kpi[7], 0) kg</b></div>
        <div><span>OEE</span><b class="bn-mono">@Twin.Fmt(Twin.Kpi[3] * 100, 1) %</b><small class="bn-mono">A @Twin.Fmt(Twin.Kpi[4] * 100, 1) · P @Twin.Fmt(Twin.Kpi[5] * 100, 1) · M @Twin.Fmt(Twin.Kpi[6] * 100, 1)</small></div>
        <div><span>@L.T("Alarm hari ini", "Alarms today")</span><b class="bn-mono">@Twin.Alarms.Count</b><small>@L.T($"{Twin.ActiveCount} masih berdiri", $"{Twin.ActiveCount} still standing")</small></div>
    </section>

    <div class="bn-sheet-wrap">
        <table class="bn-sheet">
            <caption>@L.T("Rata-rata tiap jam. Merah: di luar batas alarm.", "Hourly means. Red: outside the alarm limit.")</caption>
            <thead>
                <tr>
                    <th scope="col">@L.T("Jam", "Hour")</th>
                    @foreach (var c in Cols)
                    {
                        var info = Plant.TagById[c.Tag];
                        <th scope="col">@info.Name<small>@info.Unit</small></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr data-hour="@r.Hour">
                        <th scope="row" class="bn-mono">@($"{r.Hour:00}.00")</th>
                        @for (var i = 0; i < Cols.Length; i++)
                        {
                            var c = Cols[i];
                            var bad = c.Bad?.Invoke(r.Values[i]) == true;
                            <td class="bn-mono @(bad ? "bad" : "")">@Twin.Fmt(r.Values[i], Plant.TagById[c.Tag].Decimals)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <section class="bn-report-cols">
        <div>
            <h2>@L.T("Alarm", "Alarms")</h2>
            <ol class="bn-log">
                @foreach (var a in Twin.Alarms.OrderBy(a => a.Raised))
                {
                    <li class="p@(a.Def.Priority)"><span class="bn-mono">@Twin.Clock(a.Raised)</span><span>@a.Def.Text</span><span class="bn-muted">@(a.Acked ? a.AckBy : L.T("belum diakui", "unacknowledged"))</span></li>
                }
            </ol>
        </div>
        <div>
            <h2>@L.T("Log shift", "Shift log")</h2>
            <ol class="bn-log">
                @foreach (var e in Twin.Log.OrderBy(e => e.T))
                {
                    <li><span class="bn-mono">@Twin.Clock(e.T)</span><span>@e.Text</span><span class="bn-muted">@e.Who</span></li>
                }
            </ol>
        </div>
    </section>
</div>

@code {
    private sealed record Col(string Tag, Func<double, bool>? Bad = null);
    private sealed record Row(int Hour, double[] Values);

    private static readonly Col[] Cols =
    {
        new("raw.turb", v => v > 150), new("raw.flow"), new("pac.dose"), new("settled.turb", v => v > 5), new("treated.turb", v => v > 1),
        new("cl.res", v => v < 0.3 || v > 1.5), new("res.level", v => v < 1.5 || v > 4.6), new("dist.press", v => v < 2.5), new("plant.kw"),
    };

    private List<Row> _rows = new();
    private long _hour = -1, _minute = -1;

    protected override void OnInitialized()
    {
        Twin.Ticked += OnTick;
        Twin.Changed += Redraw;
        Load();
    }

    private void Load()
    {
        if (!Twin.Ready) return;
        var r = Js.Call("bn.hourly", w =>
        {
            w.BeginObject().Name("tags").BeginArray();
            foreach (var c in Cols) w.String(c.Tag);
            w.EndArray().EndObject();
        });
        _rows = r.Items.Select(x => new Row(x["h"].AsInt(), x["v"].Items.Select(v => v.AsDouble()).ToArray())).ToList();
        _hour = Twin.Now / 600;
    }

    private void OnTick()
    {
        // totals every simulated minute; the hourly means every ten
        if (Twin.Now / 60 == _minute) return;
        _minute = Twin.Now / 60;
        if (Twin.Now / 600 != _hour) Load();
        StateHasChanged();
    }

    private void Redraw() => StateHasChanged();

    private void ExportHourly()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(L.T("jam", "hour"));
        foreach (var c in Cols)
        {
            var info = Plant.TagById[c.Tag];
            var h = $"{info.Name} ({info.Unit})";
            sb.Append(',').Append(h.Contains(',') ? "\"" + h + "\"" : h);
        }
        sb.Append("\r\n");
        foreach (var r in _rows)
        {
            sb.Append($"{r.Hour:00}:00");
            foreach (var v in r.Values) sb.Append(',').Append(v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture));
            sb.Append("\r\n");
        }
        Js.Send("bn.download", Js.Args("name", $"bening-{Plant.Date}-{(L.English ? "hourly" : "per-jam")}.csv", "text", sb.ToString(), "mime", "text/csv"));
        Toasts.Success(L.T($"Log per jam diekspor: {_rows.Count} baris.", $"Exported the hourly log: {_rows.Count} rows."));
    }

    public void Dispose()
    {
        Twin.Ticked -= OnTick;
        Twin.Changed -= Redraw;
    }
}
