<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- A Rustzor sample app: gobak sodor (galasin) for several players across browser tabs. Built by Gravicode Studios, led by Kang Fadhil. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Galasin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The yard engine: glTF loading, GPU skinning, animation blending, shadows, local movement, sound. -->
    <EmbeddedResource Include="rustzor.module.js" LogicalName="rustzor.module.js" />
    <None Remove="assets-src\**" />
    <ProjectReference Include="..\..\src\Rustzor.UI\Rustzor.UI.csproj" />
    <ProjectReference Include="..\..\src\Frameworks\Rustzor.Game\Rustzor.Game.csproj" />
    <ProjectReference Include="..\..\src\Browser\Rustzor.Browser.Storage\Rustzor.Browser.Storage.csproj" />
  </ItemGroup>
</Project>
