<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(PosLayout)" />
    </Found>
    <NotFound>
        <EmptyState Icon="map" Title="Nothing here" Text="This screen does not exist. Go back to the register." />
    </NotFound>
</Router>
