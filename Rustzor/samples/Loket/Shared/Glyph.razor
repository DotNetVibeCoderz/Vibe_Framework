@* Line icons drawn for Loket, 24-unit grid, stroke follows currentColor. *@
<svg class="lk-glyph" width="@Size" height="@Size" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "search": <circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /> break;
        case "doc": <path d="M7 3h7l5 5v13H7z" /><path d="M14 3v5h5M10 13h6M10 17h6" /> break;
        case "note": <path d="M5 4h14v16H5z" /><path d="M9 9h6M9 13h6M9 17h3" /> break;
        case "gear": <circle cx="12" cy="12" r="3" /><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7" /> break;
        case "send": <path d="M4 12 20 4l-6 16-3-7z" /><path d="m11 13 9-9" /> break;
        case "stop": <rect x="7" y="7" width="10" height="10" rx="1.5" /> break;
        case "mic": <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" /> break;
        case "image": <rect x="3.5" y="5" width="17" height="14" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5" /> break;
        case "trash": <path d="M4.5 7h15M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /> break;
        case "edit": <path d="M4 20h4L19 9l-4-4L4 16z" /><path d="m13.5 6.5 4 4" /> break;
        case "download": <path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /> break;
        case "speaker": <path d="M4 10v4h4l5 4V6l-5 4z" /><path d="M16.5 9a4 4 0 0 1 0 6M19 6.5a7.5 7.5 0 0 1 0 11" /> break;
        case "mute": <path d="M4 10v4h4l5 4V6l-5 4z" /><path d="m17 9.5 4 5M21 9.5l-4 5" /> break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h16" /> break;
        case "close": <path d="m6 6 12 12M18 6 6 18" /> break;
        case "check": <path d="m5 12.5 4.5 4.5L19 7.5" /> break;
        case "calc": <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M8 7h8M8.5 12h.01M12 12h.01M15.5 12h.01M8.5 16h.01M12 16h.01M15.5 16h.01" /> break;
        case "clock": <circle cx="12" cy="12" r="8.5" /><path d="M12 7v5l3.5 2" /> break;
        case "pin": <path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /> break;
        case "chat": <path d="M4 5h16v11H9l-5 4z" /> break;
        case "globe": <circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17M12 3.5c2.5 2.5 3.5 5.5 3.5 8.5s-1 6-3.5 8.5c-2.5-2.5-3.5-5.5-3.5-8.5s1-6 3.5-8.5z" /> break;
        case "upload": <path d="M12 16V5M7 9.5l5-5 5 5M5 20h14" /> break;
        case "warn": <path d="M12 4 2.5 20h19z" /><path d="M12 10v4.5M12 17.5h.01" /> break;
        default: <circle cx="12" cy="12" r="3" /> break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
