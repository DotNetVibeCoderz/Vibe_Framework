@page "/"
<p id="picked">picked: @_picked</p>
<button id="more" @onclick="More">more</button>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
    <ChartJs Type="bar" Labels="_labels" Datasets="_sets" Height="220" OnClick="c => _picked = c.Label" />
    <EChart Option="_option" Height="220" />
    <D3Chart Kind="bar" Data="_data" Height="220" OnSelect="s => _picked = s" />
    <D3Chart Kind="pie" Data="_data" Height="220" />
    <D3Chart Kind="line" Series="_series" Height="220" />
    <D3Chart Kind="force" Nodes="_nodes" Links="_links" Height="220" />
    <D3Chart Kind="treemap" Tree="_tree" Height="220" />
    <D3Script Data="_data" Height="220" Script="@Script" />
</div>

@code {
    private string _picked = "";
    private readonly List<string> _labels = new() { "Jan", "Feb", "Mar", "Apr" };
    private List<ChartJsDataset> _sets = new() { new ChartJsDataset { Label = "Sales", Data = new List<double> { 4, 7, 3, 9 } } };
    private EChartOption _option = EChartOption.Line(new[] { "Mon", "Tue", "Wed", "Thu" }).AddLine("Visits", new double[] { 120, 200, 150, 80 }, area: true);
    private List<D3Datum> _data = new() { new("North", 30), new("South", 55), new("East", 18), new("West", 41) };
    private readonly List<D3Point> _series = Enumerable.Range(0, 12).Select(i => new D3Point(new DateTime(2026, 1, 1).AddDays(i * 7), 20 + i * 3 + (i % 3) * 5)).ToList();
    private readonly List<D3Node> _nodes = new() { new("a", "Core", 0, 10), new("b", "UI", 1), new("c", "Charts", 2), new("d", "Data", 3), new("e", "Game", 4) };
    private readonly List<D3Link> _links = new() { new("a", "b"), new("a", "c"), new("a", "d"), new("a", "e"), new("b", "c") };
    private readonly D3Tree _tree = new D3Tree("root")
        .Add(new D3Tree("Runtime").Add(new D3Tree("IL", 40)).Add(new D3Tree("GC", 25)))
        .Add(new D3Tree("Browser").Add(new D3Tree("DOM", 30)).Add(new D3Tree("Fetch", 15)).Add(new D3Tree("WebGPU", 20)));
    private const string Script = "svg.selectAll('circle').data(data).join('circle').attr('cx',(d,i)=>40+i*80).attr('cy',height/2).attr('r',d=>d.value/2).attr('fill','teal').attr('class','custom');";

    private void More()
    {
        _data = _data.Select(d => d with { Value = d.Value + 10 }).ToList();
        _sets = new() { new ChartJsDataset { Label = "Sales", Data = new List<double> { 5, 8, 6, 12 } } };
    }
}
