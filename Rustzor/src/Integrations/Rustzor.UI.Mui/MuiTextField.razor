<MuiIsland Tree="Tree()" OnEvent="Handle" />

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    /// <summary>"outlined", "filled" or "standard".</summary>
    [Parameter] public string Variant { get; set; } = "outlined";
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Error { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool FullWidth { get; set; } = true;
    [Parameter] public string Size { get; set; } = "medium";
    [Parameter] public bool Disabled { get; set; }
    /// <summary>A Material Icons name shown at the start of the field.</summary>
    [Parameter] public string? StartIcon { get; set; }

    private object Tree()
    {
        var p = new MuiProps
        {
            ["label"] = Label,
            ["value"] = Value,
            ["variant"] = Variant,
            ["type"] = Type,
            ["error"] = Error,
            ["fullWidth"] = FullWidth,
            ["size"] = Size,
            ["disabled"] = Disabled,
            ["onChange"] = Mui.Event("change"),
        }.Set("placeholder", Placeholder).Set("helperText", HelperText);
        if (Multiline)
        {
            p["multiline"] = true;
            p["rows"] = Rows;
        }
        if (StartIcon is not null)
            p["InputProps"] = new MuiProps { ["startAdornment"] = Mui.El("InputAdornment", new { position = "start" }, Mui.Icon(StartIcon)) };
        return Mui.El("TextField", p);
    }

    private Task Handle(MuiEvent e)
    {
        Value = e.Value.AsString();
        return ValueChanged.InvokeAsync(Value);
    }
}
