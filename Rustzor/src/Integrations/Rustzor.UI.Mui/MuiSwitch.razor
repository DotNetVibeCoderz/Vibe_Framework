<MuiIsland Tree="Tree()" OnEvent="Handle" />

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string Color { get; set; } = "primary";
    /// <summary>A checkbox instead of a switch.</summary>
    [Parameter] public bool Checkbox { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private object Tree() => Mui.El("FormControlLabel", new MuiProps
    {
        ["label"] = Label,
        ["disabled"] = Disabled,
        ["control"] = Mui.El(Checkbox ? "Checkbox" : "Switch", new MuiProps
        {
            ["checked"] = Checked,
            ["color"] = Color,
            ["onChange"] = Mui.Event("change"),
        }),
    });

    private Task Handle(MuiEvent e)
    {
        Checked = e.Value.AsBool();
        return CheckedChanged.InvokeAsync(Checked);
    }
}
