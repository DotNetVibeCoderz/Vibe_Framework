<MuiIsland Tree="Tree()" Slots="_slots">@ChildContent</MuiIsland>

@code {
    private Dictionary<string, RenderFragment>? _slots;

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subheader { get; set; }
    /// <summary>Initials or a short label shown in an avatar beside the title.</summary>
    [Parameter] public string? Avatar { get; set; }
    /// <summary>"elevation" or "outlined".</summary>
    [Parameter] public string Variant { get; set; } = "outlined";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Buttons along the bottom of the card.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    protected override void OnParametersSet() =>
        _slots = Actions is null ? null : new Dictionary<string, RenderFragment> { ["actions"] = Actions };

    private object Tree()
    {
        var parts = new List<object>();
        if (Title is not null)
            parts.Add(Mui.El("CardHeader", new MuiProps { ["title"] = Title }
                .Set("subheader", Subheader)
                .Set("avatar", Avatar is null ? null : Mui.El("Avatar", new { sx = new { bgcolor = "primary.main" } }, Avatar))));
        if (ChildContent is not null) parts.Add(Mui.El("CardContent", null, Mui.Slot()));
        if (Actions is not null) parts.Add(Mui.El("CardActions", null, Mui.Slot("actions")));
        return Mui.El("Card", new MuiProps { ["variant"] = Variant }, parts);
    }
}
