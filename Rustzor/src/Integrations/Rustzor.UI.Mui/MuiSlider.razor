<MuiIsland Tree="Tree()" OnEvent="Handle" />

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Marks { get; set; }
    /// <summary>"auto", "on" or "off".</summary>
    [Parameter] public string ValueLabel { get; set; } = "auto";
    [Parameter] public string Color { get; set; } = "primary";
    [Parameter] public string? AriaLabel { get; set; }

    private object Tree() => Mui.El("Slider", new MuiProps
    {
        ["value"] = Value,
        ["min"] = Min,
        ["max"] = Max,
        ["step"] = Step,
        ["marks"] = Marks,
        ["valueLabelDisplay"] = ValueLabel,
        ["color"] = Color,
        ["onChange"] = Mui.Event("change"),
    }.Set("aria-label", AriaLabel));

    private Task Handle(MuiEvent e)
    {
        Value = e.Value.AsDouble();
        return ValueChanged.InvokeAsync(Value);
    }
}
