@typeparam TItem
<div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-stone-200 text-sm dark:divide-stone-800">
        @if (Header is not null)
        {
            <thead class="bg-stone-50 text-left text-xs font-semibold uppercase tracking-wider text-stone-500 dark:bg-stone-950/40 dark:text-stone-400 [&_th]:px-4 [&_th]:py-3">
                <tr>@Header</tr>
            </thead>
        }
        <tbody class="divide-y divide-stone-100 text-stone-700 dark:divide-stone-800 dark:text-stone-300 [&_td]:px-4 [&_td]:py-3">
            @foreach (var item in Items)
            {
                var row = item;
                <tr class="@Tw.Css("transition-colors hover:bg-stone-50 dark:hover:bg-stone-800/50", OnRowClick.HasDelegate ? "cursor-pointer" : null)" @onclick="() => Click(row)">@Row(row)</tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    /// <summary>The th cells.</summary>
    [Parameter] public RenderFragment? Header { get; set; }
    /// <summary>The td cells of one row.</summary>
    [Parameter] public RenderFragment<TItem> Row { get; set; } = default!;
    [Parameter] public EventCallback<TItem> OnRowClick { get; set; }

    private Task Click(TItem item) => OnRowClick.HasDelegate ? OnRowClick.InvokeAsync(item) : Task.CompletedTask;
}
