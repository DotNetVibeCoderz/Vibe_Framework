<section class="@Tw.Css("rounded-xl border border-stone-200 bg-white shadow-sm dark:border-stone-800 dark:bg-stone-900", Class)">
    @if (Title is not null || Actions is not null)
    {
        <header class="flex items-start justify-between gap-4 border-b border-stone-200 px-5 py-4 dark:border-stone-800">
            <div>
                <h3 class="font-display text-base font-semibold text-stone-900 dark:text-stone-50">@Title</h3>
                @if (Subtitle is not null)
                {
                    <p class="mt-0.5 text-sm text-stone-500 dark:text-stone-400">@Subtitle</p>
                }
            </div>
            @Actions
        </header>
    }
    <div class="@Tw.Css(Flush ? null : "p-5")">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>No padding around the body (for tables and media).</summary>
    [Parameter] public bool Flush { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
