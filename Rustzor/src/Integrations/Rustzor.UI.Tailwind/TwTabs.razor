@* Segmented tabs by title; the active title is two-way bindable. *@
<div role="tablist" class="inline-flex rounded-lg bg-stone-100 p-1 dark:bg-stone-800">
    @foreach (var t in Titles)
    {
        var title = t;
        <button type="button" role="tab" aria-selected="@(title == Active ? "true" : "false")" @onclick="() => Select(title)"
                class="@Tw.Css("rounded-md px-3 py-1.5 text-sm font-medium transition",
                               title == Active ? "bg-white text-stone-900 shadow-sm dark:bg-stone-950 dark:text-stone-50" : "text-stone-500 hover:text-stone-800 dark:text-stone-400 dark:hover:text-stone-200")">@title</button>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> Titles { get; set; } = Array.Empty<string>();
    [Parameter] public string Active { get; set; } = "";
    [Parameter] public EventCallback<string> ActiveChanged { get; set; }

    private Task Select(string title)
    {
        Active = title;
        return ActiveChanged.InvokeAsync(title);
    }
}
