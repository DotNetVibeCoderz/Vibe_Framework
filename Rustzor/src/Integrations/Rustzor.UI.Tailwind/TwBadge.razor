<span class="@Tw.Css("inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset", Tw.Variant(Tone, Tones))">@ChildContent</span>

@code {
    private static readonly Dictionary<string, string> Tones = new()
    {
        ["neutral"] = "bg-stone-50 text-stone-700 ring-stone-600/20 dark:bg-stone-800 dark:text-stone-300 dark:ring-stone-500/30",
        ["rust"] = "bg-rust-50 text-rust-800 ring-rust-600/20 dark:bg-rust-500/10 dark:text-rust-300 dark:ring-rust-400/30",
        ["success"] = "bg-patina-50 text-patina-800 ring-patina-600/20 dark:bg-patina-500/10 dark:text-patina-300 dark:ring-patina-400/30",
        ["warning"] = "bg-amber-50 text-amber-800 ring-amber-600/20 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-400/30",
        ["danger"] = "bg-red-50 text-red-700 ring-red-600/20 dark:bg-red-500/10 dark:text-red-300 dark:ring-red-400/30",
    };

    /// <summary>"neutral", "rust", "success", "warning" or "danger".</summary>
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
