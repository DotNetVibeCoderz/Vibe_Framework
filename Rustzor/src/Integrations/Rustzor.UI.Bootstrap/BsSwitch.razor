<div class="form-check form-switch">
    <input id="@_id" class="form-check-input" type="checkbox" role="switch" checked="@Value" @onchange="Changed" />
    <label class="form-check-label" for="@_id">@Label</label>
</div>

@code {
    private static int _ids;
    private readonly string _id = "bs-switch-" + ++_ids;

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private Task Changed(ChangeEventArgs e)
    {
        Value = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        return ValueChanged.InvokeAsync(Value);
    }
}
