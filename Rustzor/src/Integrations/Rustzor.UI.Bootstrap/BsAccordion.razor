@* Accordion: put BsAccordionItem children inside. *@
<CascadingValue Value="this" IsFixed="true">
    <div class="@Bs.Css("accordion", Flush ? "accordion-flush" : null)">@ChildContent</div>
</CascadingValue>

@code {
    private readonly HashSet<BsAccordionItem> _open = new();

    [Parameter] public bool Flush { get; set; }
    /// <summary>Allow several items open at once.</summary>
    [Parameter] public bool AlwaysOpen { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal bool IsOpen(BsAccordionItem item) => _open.Contains(item);

    internal void Init(BsAccordionItem item)
    {
        if (item.InitiallyOpen) _open.Add(item);
    }

    internal void Toggle(BsAccordionItem item)
    {
        if (!_open.Remove(item))
        {
            if (!AlwaysOpen) _open.Clear();
            _open.Add(item);
        }
        StateHasChanged();
    }
}
