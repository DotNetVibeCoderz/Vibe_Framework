@if (Open)
{
    <div class="rz-bs-backdrop"></div>
    <div class="modal rz-bs-modal" tabindex="-1" role="dialog" aria-modal="true" aria-label="@Title" @onclick="Backdrop">
        <div class="@Bs.Css("modal-dialog", "modal-dialog-centered", Size is null ? null : "modal-" + Size, Scrollable ? "modal-dialog-scrollable" : null)" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="modal-body">@ChildContent</div>
                @if (Footer is not null)
                {
                    <div class="modal-footer">@Footer</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public string Title { get; set; } = "";
    /// <summary>"sm", "lg", "xl" or "fullscreen".</summary>
    [Parameter] public string? Size { get; set; }
    [Parameter] public bool Scrollable { get; set; }
    /// <summary>When true, clicking outside the dialog does not close it.</summary>
    [Parameter] public bool StaticBackdrop { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    public Task Close()
    {
        Open = false;
        return OpenChanged.InvokeAsync(false);
    }

    private Task Backdrop() => StaticBackdrop ? Task.CompletedTask : Close();
}
