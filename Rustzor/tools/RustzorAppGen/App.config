<?xml version="1.0" encoding="utf-8"?>
<!--
  Rustzor App Generator settings. Everything here can also be changed in the
  app (Settings). API keys are stored as plain text in this file on your
  machine, so keep it out of source control.
-->
<configuration>
  <appSettings>
    <!-- Active model, as "Provider|model". Providers: OpenAI, AzureOpenAI, Claude, Gemini, Ollama. -->
    <add key="ActiveModel" value="AzureOpenAI|gpt-5-mini" />

    <add key="OpenAI.Models" value="gpt-4.1,gpt-4.1-mini,gpt-4o-mini" />
    <add key="OpenAI.ApiKey" value="" />
    <add key="OpenAI.Endpoint" value="https://api.openai.com/v1" />

    <add key="AzureOpenAI.Models" value="gpt-5-mini" />
    <add key="AzureOpenAI.ApiKey" value="" />
    <add key="AzureOpenAI.Endpoint" value="" />

    <add key="Claude.Models" value="claude-sonnet-4-5,claude-opus-4-1,claude-haiku-4-5" />
    <add key="Claude.ApiKey" value="" />
    <add key="Claude.Endpoint" value="https://api.anthropic.com" />
    <add key="Claude.WorkspaceId" value="" />

    <add key="Gemini.Models" value="gemini-2.5-flash,gemini-2.5-pro" />
    <add key="Gemini.ApiKey" value="" />
    <add key="Gemini.Endpoint" value="https://generativelanguage.googleapis.com/v1beta/openai" />

    <add key="Ollama.Models" value="qwen2.5-coder:7b,llama3.1:8b" />
    <add key="Ollama.ApiKey" value="" />
    <add key="Ollama.Endpoint" value="http://localhost:11434/v1" />

    <!-- Empty temperature leaves it to the model (some reasoning models accept only their default). -->
    <add key="Temperature" value="" />
    <add key="MaxOutputTokens" value="8000" />
    <add key="SystemPrompt" value="" />
    <add key="TavilyApiKey" value="" />

    <!-- How generated projects reference Rustzor: "Source" (a local checkout) or "NuGet". -->
    <add key="RustzorReference" value="Source" />
    <add key="RustzorRoot" value="" />
    <add key="RustzorVersion" value="0.1.0" />
    <add key="ProjectsFolder" value="" />
    <add key="DeployFolder" value="" />
    <add key="ServePort" value="5170" />

    <add key="Theme" value="Dark" />
    <add key="EditorFontSize" value="14" />
    <add key="ShowLineNumbers" value="true" />
    <add key="WordWrap" value="false" />
    <add key="ChatPanelWidth" value="420" />
    <add key="ChatPanelVisible" value="true" />
    <add key="ExplorerWidth" value="260" />
    <add key="LogsVisible" value="true" />
    <add key="RecentProjects" value="" />
  </appSettings>
</configuration>
