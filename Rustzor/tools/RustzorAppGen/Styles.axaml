<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Background" Value="{DynamicResource Bg0}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <!-- Section labels: small caps-like, tracked out. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Toolbar and panel buttons: quiet until hovered. -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="Button.tool:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.tool PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="Button.tool:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="Button.tool.run PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Patina}" />
  </Style>
  <Style Selector="Button.tool.run TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Patina}" />
  </Style>
  <Style Selector="Button.tool.build PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource Ember}" />
  </Style>

  <!-- The one loud button: primary actions. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Ember}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- Explorer tree. -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>

  <!-- Editor tabs. -->
  <Style Selector="Border.tab">
    <Setter Property="Padding" Value="12,0,6,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Background" Value="{DynamicResource Bg1}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tab.active">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
  </Style>
  <Style Selector="Border.tab.active Border.tabmark">
    <Setter Property="Background" Value="{DynamicResource Ember}" />
  </Style>

  <!-- Chat: the hammer-strike chip for every tool call. -->
  <Style Selector="Border.strike">
    <Setter Property="Background" Value="{DynamicResource PatinaSoft}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="0,2,0,2" />
  </Style>
  <Style Selector="Border.codeblock">
    <Setter Property="Background" Value="{DynamicResource CodeBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,6" />
  </Style>

  <!-- The heat line beside Jack's reply glows while he works. -->
  <Style Selector="Border.heat">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Border.heat.hot">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#F9B45B" Offset="0" />
        <GradientStop Color="#E8692A" Offset="0.5" />
        <GradientStop Color="#9A3412" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Ellipse.ember-dot.hot">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Template gallery cards. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Faint}" />
  </Style>
  <Style Selector="Border.card.picked">
    <Setter Property="BorderBrush" Value="{DynamicResource Ember}" />
    <Setter Property="Background" Value="{DynamicResource Selected}" />
  </Style>

  <!-- Panel tabs (Output / Problems): an ember underline, not a filled button. -->
  <Style Selector="ToggleButton.tool">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.tool:checked">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Ember}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource Ember}" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
</Styles>
