# RustNet on ESP32: generous stacks for the IL interpreter's recursion,
# quiet console (UART0 carries RNDP frames, not logs).
#
# Custom partition table with a FAT "storage" partition (partitions.csv) — the
# default single-app table has none, so mount_fat() falls back to in-RAM MemFs
# and apps + provisioning vanish on reboot (breaking autostart). 4 MB layout
# fits both the 4 MB WROOM DevKit and the 16 MB M5 Tough.
#
# A relative name here resolves against esp-idf-sys's OUT_DIR deep in the
# target dir, so it is never found; this once held an absolute path instead,
# which broke the day the repo moved. The value is copied verbatim into
# CMake's sdkconfig.cmake, where `$ENV{...}` expands — and .cargo/config.toml
# sets RUSTNET_ESP32_DIR to this crate's directory for every build. When
# flashing, pass the same table to the flasher so the device actually gets
# the storage partition (`rustnet firmware flash` does):
#   espflash flash <elf> --partition-table runtime/firmware-esp32/partitions.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{RUSTNET_ESP32_DIR}/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_ESP_TASK_WDT_INIT=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# Trim WiFi/lwIP buffers: RSA-2048 verification needs heap headroom.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_TCP_WND_DEFAULT=4096
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6
# PSRAM: a 320x240 RGB565 framebuffer is 150 KB — far larger than any
# contiguous internal-DRAM block. Route large allocations to SPI RAM (the M5
# Tough has 8 MB). IGNORE_NOTFOUND keeps PSRAM-less boards (WROOM DevKit)
# booting; small allocations stay internal for speed.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
