<window width="240" height="300" pad="6" gap="4" bg="0841">
  <label text="Parity Ag" scale="2" fg="FFE0"/>
  <stack orient="horizontal" gap="6">
    <checkbox text="Fan" checked="true"/>
    <radio text="A" group="g" checked="true"/>
    <radio text="B" group="g"/>
  </stack>
  <slider min="0" max="100" value="35" height="12"/>
  <progress value="60" max="100" height="8"/>
  <stack orient="horizontal" gap="4">
    <button text="Go" width="40" height="18"/>
    <textbox text="abc" width="70" height="18"/>
    <combobox items="One;Two" selected="1" width="70" height="18"/>
  </stack>
  <listbox items="North;South;East" selected="1" height="40"/>
  <stack orient="horizontal" gap="4" height="60">
    <gauge value="70" min="0" max="100" width="70" height="56"/>
    <chart series="3,9,4,12,7,15,6" width="80" height="56"/>
    <ellipse width="40" height="40" bg="F800" border="FFFF"/>
  </stack>
  <groupbox text="Box" height="30">
    <label text="inside"/>
  </groupbox>
</window>
