<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs every actuator / LED / converter / expander / RTC / digipot driver
       against bus simulators on the RustNet interpreter (virtual device).
       Proves the drivers compile to RNX and execute in the device dialect. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DriversActuatorsApp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\RustNet.Core\RustNet.Core.csproj" />
    <ProjectReference Include="..\..\..\src\RustNet.Hal\RustNet.Hal.csproj" />
    <ProjectReference Include="..\..\..\src\RustNet.Buses\RustNet.Buses.csproj" />
  </ItemGroup>
  <Import Project="Packages.props" />
</Project>
