<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to rustnet-designer.secrets.config and fill in the keys you
  have. That name is gitignored, so real credentials never reach the repository.

  App.config pulls it in with
    <appSettings file="rustnet-designer.secrets.config">
  and anything set here overrides the ${ENV_VAR} placeholder there. Exporting the
  environment variables instead works just as well — pick whichever suits you.

  Only include the providers you actually use; missing keys simply leave that
  provider unconfigured, and the panel says so.
-->
<appSettings>
  <add key="Assistant.OpenAI.ApiKey" value="sk-..." />
  <add key="Assistant.Anthropic.ApiKey" value="sk-ant-..." />
  <add key="Assistant.Gemini.ApiKey" value="..." />
  <!-- Internet search for the assistant: https://tavily.com -->
  <add key="Tools.Tavily.ApiKey" value="tvly-..." />
</appSettings>
