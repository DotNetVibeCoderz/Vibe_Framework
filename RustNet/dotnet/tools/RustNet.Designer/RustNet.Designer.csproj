<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>RustNet UI Designer: a WPF drag-and-drop editor for embedded UI that opens/edits/saves the RustNet.UI XML layout format.</Description>
    <AssemblyName>rustnet-designer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RustNet.UI\RustNet.UI.csproj" />
  </ItemGroup>
</Project>
