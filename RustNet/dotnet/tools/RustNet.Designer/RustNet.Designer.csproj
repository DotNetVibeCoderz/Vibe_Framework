<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>RustNet UI Designer: a WPF drag-and-drop editor for embedded UI that opens/edits/saves the RustNet.UI XML layout format, with the "Jack The Code Bender" AI assistant.</Description>
    <AssemblyName>rustnet-designer</AssemblyName>
    <!-- Semantic Kernel marks connectors and a few kernel APIs experimental;
         we opt in deliberately rather than sprinkling pragmas. -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0020;SKEXP0040;SKEXP0050;SKEXP0070;SKEXP0110</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Everything that is not a view: the assistant, the deployment
         pipeline, the formatter and the canvas geometry. It targets plain
         net10.0, so it is also what a future Avalonia front-end and the test
         suite reference. See RustNet.Designer.Core. -->
    <ProjectReference Include="..\RustNet.Designer.Core\RustNet.Designer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- What is left here is what genuinely needs Windows. WebView2 shows the
         HTML the Core's MarkdownRenderer produces, and AvalonEdit is the code
         pane; both are WPF-only, and both are the reason a port to Avalonia
         has to make a decision rather than a translation. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <ItemGroup>
    <None Update="App.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Local credentials, gitignored. App.config pulls it in with
         <appSettings file="…">, so it has to sit beside the exe. Absent in a
         fresh checkout, which is fine — the placeholders fall back to the
         environment. -->
    <None Update="rustnet-designer.secrets.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="rustnet-designer.secrets.config.example" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
