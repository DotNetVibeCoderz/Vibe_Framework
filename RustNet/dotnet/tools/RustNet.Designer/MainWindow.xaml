<Window x:Class="RustNet.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustNet UI Designer" Height="720" Width="1120"
        Background="#FF2D2D30" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFDDDDDD"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
            <Setter Property="BorderBrush" Value="#FF555559"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="#FF3F3F46" Foreground="#FFEEEEEE">
            <MenuItem Header="_File" Foreground="Black">
                <MenuItem Header="_New" Click="OnNew" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open..." Click="OnOpen" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Save" Click="OnSave" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _As..." Click="OnSaveAs"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="Black">
                <MenuItem Header="_Delete Selected" Click="OnDelete" InputGestureText="Del"/>
                <MenuItem Header="Move _Up" Click="OnMoveUp"/>
                <MenuItem Header="Move _Down" Click="OnMoveDown"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#FF007ACC" Foreground="White">
            <TextBlock x:Name="StatusText" Foreground="White" Text="Ready"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Toolbox -->
            <DockPanel Grid.Column="0" Background="#FF252526">
                <TextBlock DockPanel.Dock="Top" Text="  Toolbox" FontWeight="Bold" Margin="0,6,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Toolbox"/>
                </ScrollViewer>
            </DockPanel>

            <!-- Design surface -->
            <Border Grid.Column="1" Background="#FF1E1E1E" BorderBrush="#FF3F3F46" BorderThickness="1,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Border x:Name="CanvasFrame" Background="#FF101010" BorderBrush="#FF555559"
                                BorderThickness="1" Margin="24" HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Canvas x:Name="DesignCanvas" Background="Transparent"
                                    MouseLeftButtonDown="OnCanvasMouseDown"
                                    MouseMove="OnCanvasMouseMove"
                                    MouseLeftButtonUp="OnCanvasMouseUp"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Right: tree + properties -->
            <Grid Grid.Column="2" Background="#FF252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="  Element Tree" FontWeight="Bold" Margin="0,6,0,4"/>
                    <TreeView x:Name="Tree" Background="#FF1E1E1E" Foreground="#FFDDDDDD"
                              BorderThickness="0" SelectedItemChanged="OnTreeSelect"/>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="3" HorizontalAlignment="Stretch" Background="#FF3F3F46"/>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="  Properties" FontWeight="Bold" Margin="0,6,0,4"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Properties" Margin="6"/>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
