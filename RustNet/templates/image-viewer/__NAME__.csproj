<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RustNetSdk Condition="'$(RustNetSdk)' == ''">$(RUSTNET_SDK)</RustNetSdk>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets/logo.gif"><LogicalName>logo.gif</LogicalName></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(RustNetSdk)\dotnet\src\RustNet.Core\RustNet.Core.csproj" />
    <ProjectReference Include="$(RustNetSdk)\dotnet\src\RustNet.Resources\RustNet.Resources.csproj" />
    <ProjectReference Include="$(RustNetSdk)\dotnet\src\RustNet.Drawing\RustNet.Drawing.csproj" />
    <ProjectReference Include="$(RustNetSdk)\dotnet\src\RustNet.Graphics\RustNet.Graphics.csproj" />
    <ProjectReference Include="$(RustNetSdk)\dotnet\src\RustNet.Diagnostics\RustNet.Diagnostics.csproj" />
  </ItemGroup>
</Project>
