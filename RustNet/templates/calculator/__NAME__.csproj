<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RustNetSdk Condition="'$(RustNetSdk)' == ''">$(RUSTNET_SDK)</RustNetSdk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RustNetSdk)\dotnet\src\RustNet.Core\RustNet.Core.csproj" />
  </ItemGroup>
</Project>
