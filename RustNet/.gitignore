target/
bin/
obj/
node_modules/
out/
*.user
.vs/
.idea/
*.rnx
!tests/fixtures/**/*.rnx
# Embedded in the STM32 firmware image via include_bytes!, so it is a build
# input rather than an artifact — a Rust-only checkout must not need dotnet.
!runtime/firmware-stm32/demo/*.rnx
artifacts/
TestResults/
.claude/worktrees/

# Signing keypairs. The private half must never be committed.
keys/

# Local API keys for the Designer's assistant. App.config keeps only
# ${ENV_VAR} placeholders; the real values live here (see the .example).
*.secrets.config

# `packages/` here is source, not a NuGet restore folder.
#
# The Vibe_Framework monorepo's root .gitignore is the standard Visual Studio
# one, and it carries `**/[Pp]ackages/*` for the old NuGet restore directory.
# That rule reaches down here and silently swallowed
# `packages/rustnet-driver-neopixel` — a community driver that exists on disk,
# is referenced by the docs, and was in no commit. A deeper .gitignore wins,
# so this puts it back. Nothing reports a file that was never added.
!packages/
!packages/**

# Loose API keys handed over for a test run. The repo convention is that
# credentials live in a gitignored *.secrets.config or in the environment;
# a bare key file at the root is neither, and `git add -A` will take it.
testkey.txt
*.key.txt
